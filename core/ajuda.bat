cls
echo ============================================================
echo              MANUAL DE OPERAÇÃO E AJUDA - UWF ETEC         
echo ============================================================
echo.
echo [1] O QUE É O UWF?
echo     O Unified Write Filter (Filtro de Gravação Unificado) protege
echo     o sistema contra alterações permanentes. Tudo o que o aluno faz
echo     vai para um arquivo temporário (Overlay) em disco e some ao reiniciar.
echo.
echo [2] CICLO DE MANUTENÇÃO (COMO USAR NO DIA A DIA):
echo     * DIA DE AULA (Protegido): 
echo       O filtro fica ativo, congelando o laboratório e bloqueando o 
echo       Windows Update para economizar banda e desempenho.
echo     * DIA DE MANUTENÇÃO (Atualizações e Instalações):
echo       1. Abra o script e escolha a [3] para desativar o filtro. Reinicie.
echo       2. Instalar programas, atualizar Chrome, pacotes Etec, etc.
echo       3. Abra o script e escolha a [2] para reativar a proteção padrão. Reinicie.
echo.
echo [3] GUIA RÁPIDO DAS OPÇÕES DO MENU PRINCIPAL:
echo     * [1] Status: Verifica compatibilidade da edição do Windows e o estado atual.
echo     * [2] Proteção: Faz limpeza, insere perfis padrão (Documentos, Android, 
echo           Autodesk, SolidWorks, Veyon) e agenda a ativação.
echo     * [3] Manutenção: Desliga o filtro e reativa os serviços do Windows Update.
echo     * [4] Ajustes Avançados: Permite redimensionar o tamanho da "Overlay" (cache).
echo     * [5] Menu de Exclusões: Permite adicionar, remover, verificar ou 
echo           RESETAR (limpar em massa) pastas, arquivos e chaves de registro.
echo     * [6] Limpeza: Executa uma faxina rápida em arquivos temporários locais.
echo     * [7] Reiniciar: Força a reinicialização rápida da máquina.
echo.
echo [4] DICA IMPORTANTE:
echo     Quase todas as alterações do UWF (ativar, desativar, mudar overlay) 
echo     EXIGEM que o computador seja reiniciado para começarem a valer.
echo ============================================================
echo.
pause